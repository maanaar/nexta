# Optional. The easiest way to set up a new server is the Server settings page in
# the app (user menu → Server settings): values saved there override this file.
# Values here are only the starting defaults.

# ETIAM DcmPRI print database (opened read-only)
ETIAM_DB_PATH=C:\ProgramData\Etiam\DcmPRI\StorePrint\sqlite.db

# Folder with incoming HL7 messages (phone numbers are read from PID-13/14)
HL7_DIR=E:\pdfsend\hl7

# Folder the PDFs land in, named by accession number: 330930.pdf, and
# 330930_2.pdf, 330930_3.pdf for later prints. Leave empty to use ETIAM only.
PDF_DIR=E:\pdf

# What each PDF file is named by: {accession} (default), @{jobuid}, {name},
# or a mix such as {name}_{accession}. Later prints get _2, _3 …
# PDF_NAME={accession}

# Nexta's own database (must stay here: it's where the Settings page saves to) (created automatically). Default: ./data/nexta.db
# NEXTA_DB_PATH=D:\nexta\nexta.db

# Secret that signs login sessions. Optional: if unset, one is generated once
# and kept in nexta.db. Changing it logs everyone out.
# NEXTA_SECRET=

# Set to 1 to log what triggered each sync and how long it took (for testing)
# NEXTA_DEBUG=1

# --- WhatsApp sending (all of these can also be set on the Settings page) ---

# Send ready reports automatically (true/false). Off by default: with it off,
# nothing is sent until someone presses Send on a report.
# AUTO_SEND=false

# Reports whose study date is before this day (YYYY-MM-DD) are never sent over
# WhatsApp. Required to turn on AUTO_SEND.
# SEND_FROM_DATE=2026-10-20

# Seconds to wait after a report's last change (new PDF / number) before it is
# sent automatically. 0 = immediately. Default 120.
# SEND_DELAY_SECONDS=120

# Meta WhatsApp Business account: phone number ID, access token and the approved
# template that carries the PDF as its document header (language code e.g. ar).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_TEMPLATE=
# WHATSAPP_LANG=ar

# Log what would be sent instead of calling Meta (to test a new server).
# WHATSAPP_DRY_RUN=false

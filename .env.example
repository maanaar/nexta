# Copy to .env.local on the ETIAM machine and adjust paths.

# ETIAM DcmPRI print database (opened read-only)
ETIAM_DB_PATH=C:\ProgramData\Etiam\DcmPRI\StorePrint\sqlite.db

# Folder with incoming HL7 messages (phone numbers are read from PID-13/14)
HL7_DIR=E:\pdfsend\hl7

# Nexta's own database (created automatically). Default: ./data/nexta.db
# NEXTA_DB_PATH=D:\nexta\nexta.db
